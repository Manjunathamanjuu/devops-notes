node{
	properties(
		[
			disableConcurrentBuilds()
		]
	)
	
	stage('Build'){
		sleep(time: 10, unit: 'SECONDS') 	
                echo 'Hello World'	
	}
}
==


==

pipeline {
  agent any
  options { 
    disableConcurrentBuilds() 
   } 
  stages {
    stage("build") {
       steps {
         sh 'sleep 10 && echo hello'
      }
   }
  }
}

pipeline {
  agent any
  options { 
    disableConcurrentBuilds(abortPrevious: true) 
   } 
  stages {
    stage("build") {
       steps {
         sh 'echo hello'
      }
   }
  }
}

click on build now,  when this is running, click again build now. previosu job is aborted and another job will be running.
===


