newContainerPerStage
=====================

Used with docker or dockerfile top-level agent. When specified, each stage will run in a new container instance on the same node, rather than all stages running in the same container instance.

node{

	stage('Build') {	
		def mavenImage = docker.image('maven:3.5.3-jdk-10-slim')
		
		mavenImage.inside{
			sh 'mvn -v'
		}
	}	

	stage('Deploy') {	
		def mavenImage = docker.image('maven:3.5.3-jdk-10-slim')
		
		mavenImage.inside{
			sh 'mvn -v'
		}
	}
}

==

pipeline {	
	agent {
		docker {
			image 'ubuntu:latest'
		}
	}
    options {	
        newContainerPerStage()
    }	
    stages {	
        stage('Build') {	
            steps {	
                sh 'cat /etc/lsb-release'
            }	
        }	
        stage('Deploy') {	
            steps {	
                sh 'cat /etc/lsb-release'
            }	
        }			
    }	
}